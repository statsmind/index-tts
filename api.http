# IndexTTS API HTTP Client Examples


# @name Health Check
GET http://localhost:18000/health

###

# @name Get Model Info
GET http://localhost:18000/info

###

# @name Upload Audio File
POST http://localhost:18000/upload
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="sample.wav"
Content-Type: audio/wav

< ./sample.wav
------WebKitFormBoundary7MA4YWxkTrZu0gW--

###

# @name List Uploaded Files
GET http://localhost:18000/list

###

# @name Download Audio File
GET http://localhost:18000/download/{{filename}}

###

# @name TTS Synthesis with Speaker Only
POST http://localhost:18000/tts
Content-Type: application/json

{
  "text": "Hello, this is a text to speech demonstration.",
  "spk_audio_prompt": "reference.wav"
}

###

# @name TTS Synthesis with Emotion Control
POST http://localhost:18000/tts
Content-Type: application/json

{
  "text": "This speech has emotional influence from the prompt.",
  "spk_audio_prompt": "speaker.wav",
  "emo_audio_prompt": "emotion.wav",
  "emo_alpha": 0.9
}

###

# @name TTS Synthesis with Emotion Vector
POST http://localhost:18000/tts
Content-Type: application/json

{
  "text": "This speech expresses specific emotions.",
  "spk_audio_prompt": "speaker.wav",
  "emo_vector": [0, 0, 0.5, 0, 0, 0, 0, 0]
}

###

# @name TTS Synthesis with Text-Based Emotion
POST http://localhost:18000/tts
Content-Type: application/json

{
  "text": "I am so thrilled about this amazing opportunity!",
  "spk_audio_prompt": "speaker.wav",
  "use_emo_text": true,
  "emo_text": "This person is very excited and happy",
  "emo_alpha": 0.6
}